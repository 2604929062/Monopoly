{
  "name": "city-property-game",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:game": "pnpm --filter game-web dev --host 0.0.0.0",
    "dev:progress": "pnpm --filter progress-web dev --host 0.0.0.0",
    "dev:progress-api": "pnpm --filter progress-api dev",
    "dev:server": "pnpm --filter game-server dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter game-rules test",
    "typecheck": "pnpm -r typecheck"
  }
}
